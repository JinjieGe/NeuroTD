# Deny by default: do not publish raw recordings, generated results or environments.
*
!.gitignore
!.gitattributes
!pyproject.toml
!LICENSE.txt

!src/
!src/neurotd/
!src/neurotd/**/
!src/neurotd/**/*.py
!examples/
!examples/**/
!examples/**/*.py
!tests/
!tests/**/
!tests/**/*.py
!docs/
!docs/*.md
!docs/assets/
!docs/assets/*.png
!data/
!data/processed/
# Only the four previously published datasets are allowlisted.
!data/processed/cell_name_to_cell_id_and_sample_id.csv
!data/processed/gxp_total_log2_filtered_pc.zip
!data/processed/m1_patchseq_meta_data.csv
!data/processed/time_delays_all_cells.csv
**/__pycache__/
**/*.pyc

# Curated revision code, small inputs and archived aggregate evidence.
!examples/revision/**/
!examples/revision/**/*.json
!examples/revision/**/*.txt
!examples/revision/**/*.csv
!examples/revision/inputs/**/*.npz
!examples/revision/inputs/dynamic_fixed/matched_control_records.csv.gz
!examples/revision/requirements.txt
# Never track generated experiment outputs or private acquisition files.
revision_runs/
validation_runs/
**/__pycache__/
**/*.pyc
